# Server credentials: never use NEXT_PUBLIC for these values.
OPENAI_API_KEY=
OPENAI_WEBHOOK_SECRET=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
DATABASE_URL=
# On Vercel, connecting the Blob store adds BLOB_STORE_ID and rotating OIDC
# credentials. Local development can use a read-write token instead.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
# IDs produced by the private agent release workflow.
AGENT21_AGENT_ID=
AGENT21_ENVIRONMENT_TEMPLATE_ID=
AGENT21_RUNTIME_VERSION=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Exact origin: set HTTP localhost for development or an approved HTTPS deployment origin.
# Production/preview origins are deliberately unset in this template.
APP_ORIGIN=
AGENT21_ENABLED=false
AGENT21_MAX_USERS=20
# Optional: fine-grained, read-only GitHub token for public repository files.
AGENT21_GITHUB_TOKEN=
# Optional: error reports (technical codes and reference IDs only).
SENTRY_DSN=
# Operator-only, for `pnpm ops report`: real costs from the OpenAI Costs API.
OPENAI_ADMIN_KEY=
OPENAI_PROJECT_ID=

CRON_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
