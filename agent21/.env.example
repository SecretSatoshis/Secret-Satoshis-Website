# Server credentials: never use NEXT_PUBLIC for these values.
OPENAI_API_KEY=
OPENAI_WEBHOOK_SECRET=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
DATABASE_URL=
# On Vercel, connecting the Blob store with OIDC adds BLOB_STORE_ID, rotating
# OIDC credentials and BLOB_WEBHOOK_PUBLIC_KEY. Local development can use a
# read-write token instead, but browser uploads still need the public key: pull
# it from the dev store's Development connection.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
BLOB_WEBHOOK_PUBLIC_KEY=
# The dashboard agent, its environment template and a runtime label.
AGENT21_AGENT_ID=
AGENT21_ENVIRONMENT_TEMPLATE_ID=
AGENT21_RUNTIME_VERSION=
# The OpenAI vault holding the GitHub MCP token, attached to each session.
AGENT21_MCP_VAULT_ID=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Exact origin: set HTTP localhost for development or an approved HTTPS deployment origin.
# Production/preview origins are deliberately unset in this template.
APP_ORIGIN=
AGENT21_ENABLED=false
# Optional: error reports (technical codes and reference IDs only).
SENTRY_DSN=
# Operator-only, for `pnpm ops report`: real costs from the OpenAI Costs API.
OPENAI_ADMIN_KEY=
OPENAI_PROJECT_ID=

# Optional: the maintenance route's bearer token, once a Vercel Cron schedules it.
CRON_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
